# CivicDataSpace Test Environment Configuration Template
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# DO NOT commit .env to version control!

# Base URLs - Replace with your actual environment URLs
HOME_URL_DEV='https://dev.yourapp.com'
HOME_URL_PROD='https://yourapp.com'
URL='https://yourapp.com/'
LOCAL='True'

# Test User Credentials - Replace with actual test account credentials
# User 1
TEST_EMAIL_1=test-user-1@example.com
TEST_PASSWORD_1=your-password-here

# User 2
TEST_EMAIL_2=test-user-2@example.com
TEST_PASSWORD_2=your-password-here

# Test Configuration
TEST_USER_INDEX=1

# API Keys (if applicable)
API_KEY=your-api-key-here

# ── API Test Configuration ─────────────────────────────────────────────────────
# Required for tests/api/ (REST + GraphQL API tests)
# Backend base URL (no trailing slash)
API_BASE_URL=http://localhost:8000

# Keycloak settings — used to obtain an auth token for API tests
# (Credentials are shared with TEST_EMAIL_1 / TEST_PASSWORD_1 above)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=your-realm-name
KEYCLOAK_CLIENT_ID=your-client-id

# Browser Configuration
HEADLESS_MODE=false
BROWSER=chrome
